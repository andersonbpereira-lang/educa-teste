# =============================================
# EDUCA- — CONFIGURAÇÃO DO BACKEND
# Nunca publique o arquivo .env real.
# =============================================

EDUCA_ENV=development

# Banco. Em produção, use um caminho persistente da hospedagem.
# Exemplo: /var/data/educa.db
EDUCA_DB=educa.db

# Segurança: gere uma chave longa e aleatória.
EDUCA_SERVER_SECRET=troque-por-uma-chave-aleatoria-grande

# URL exata do GitHub Pages em produção.
EDUCA_ALLOWED_ORIGINS=https://andersonbpereira-lang.github.io

# E-mail SMTP
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=seu-email@exemplo.com
SMTP_PASSWORD=sua-senha-ou-senha-de-aplicativo
SMTP_FROM=seu-email@exemplo.com
SMTP_TLS=1

# Professor IA — somente no backend
OPENAI_API_KEY=coloque-a-chave-apenas-no-servidor
OPENAI_MODEL=gpt-5.6-luna

# A hospedagem normalmente fornece PORT automaticamente.
PORT=5000
